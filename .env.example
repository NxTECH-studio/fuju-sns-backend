# FUJU Backend - Environment Configuration Example
# Copy this file to .env and fill in the actual values

# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fuju
DB_USER=fuju
DB_PASSWORD=your_secure_password
DB_MAX_CONN=25
DB_MIN_CONN=5

# AuthCore Configuration
# Base URL of the AuthCore service (no trailing slash)
AUTHCORE_BASE_URL=http://localhost:9000
# AuthCore client credentials (RFC 6749 confidential client, used for RFC 7662 introspection)
AUTHCORE_CLIENT_ID=your_client_id
AUTHCORE_CLIENT_SECRET=your_client_secret
# RFC 7662 introspect endpoint path (relative to AUTHCORE_BASE_URL)
AUTHCORE_INTROSPECT_PATH=/v1/auth/introspect
# User profile endpoint path (called with the user's access token)
AUTHCORE_PROFILE_PATH=/v1/user/profile
# TTL of the cached AuthCore profile stored in the users mirror table
AUTHCORE_PROFILE_TTL=1h
# TTL of the in-memory introspection cache
AUTHCORE_INTROSPECT_CACHE_TTL=30s

# Cloudflare R2 Configuration (S3-compatible)
# Get these from your Cloudflare R2 dashboard
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
# Replace <account_id> with your actual Cloudflare Account ID
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=my-bucket
# Your public domain for accessing uploaded files
# Example: https://pub-xxxx.r2.dev
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
# Maximum file size for uploads (in bytes, default: 5MB)
R2_MAX_FILE_SIZE=5242880

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "http://localhost:3000,https://example.com")
# Use "*" to allow all origins (development only)
CORS_ALLOWED_ORIGINS=*

# OGP Fetcher Configuration
# User-Agent header sent by the background OGP preview worker. Identifying
# the bot lets remote sites opt out via robots.txt or rate-limit you.
OGP_USER_AGENT=FujuBot/1.0 (+https://fuju.example.com/bot)
