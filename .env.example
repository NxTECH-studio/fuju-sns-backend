# FUJU Backend - Environment Configuration Example
# Copy this file to .env and fill in the actual values

# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fuju
DB_USER=fuju
DB_PASSWORD=your_secure_password
DB_MAX_CONN=25
DB_MIN_CONN=5

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AuthCore Configuration
# Base URL of the internal AuthCore service (no trailing slash)
AUTHCORE_BASE_URL=http://localhost:9000
# Service-to-service token issued by AuthCore for this backend
AUTHCORE_SERVICE_TOKEN=your_authcore_service_token
# Cookie name set by AuthCore on the browser session
AUTHCORE_SESSION_COOKIE_NAME=authcore_session
# Introspection endpoint path (relative to AUTHCORE_BASE_URL)
AUTHCORE_INTROSPECT_PATH=/internal/introspect
# TTL of the cached AuthCore profile stored in the users mirror table
AUTHCORE_PROFILE_TTL=1h
# TTL of the in-memory introspection cache
AUTHCORE_INTROSPECT_CACHE_TTL=30s

# Cloudflare R2 Configuration (S3-compatible)
# Get these from your Cloudflare R2 dashboard
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
# Replace <account_id> with your actual Cloudflare Account ID
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=my-bucket
# Your public domain for accessing uploaded files
# Example: https://pub-xxxx.r2.dev
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
# Maximum file size for uploads (in bytes, default: 5MB)
R2_MAX_FILE_SIZE=5242880

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "http://localhost:3000,https://example.com")
# Use "*" to allow all origins (development only)
CORS_ALLOWED_ORIGINS=*

# Frontend URL (optional, used by some flows)
FRONTEND_URL=http://localhost:5173
