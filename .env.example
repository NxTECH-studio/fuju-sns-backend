# FUJU Backend - Environment Configuration Example
# Copy this file to .env and fill in the actual values

# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fuju
DB_USER=fuju
DB_PASSWORD=your_secure_password
DB_MAX_CONN=25
DB_MIN_CONN=5

# Redis Configuration
REDIS_URL=redis://localhost:6379

# OAuth2 Configuration
# For development, use Google or GitHub OAuth2
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URL=http://localhost:8080/v1/auth/oauth/callback

# JWT Configuration
# Generate a secure random string for JWT_SECRET
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=1800

# Session Configuration
# Generate a secure random string for SESSION_SECRET
# Example: openssl rand -base64 32
SESSION_SECRET=your_session_secret_key
SESSION_DURATION=86400

# Cloudflare R2 Configuration (S3-compatible)
# Get these from your Cloudflare R2 dashboard
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
# Replace <account_id> with your actual Cloudflare Account ID
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=my-bucket
# Your public domain for accessing uploaded files
# Example: https://pub-xxxx.r2.dev
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
# Maximum file size for uploads (in bytes, default: 5MB)
R2_MAX_FILE_SIZE=5242880
