{
  "// Editor Settings": "=====================================",
  "editor.defaultFormatter": "golang.go",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [80, 120],
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.trimAutoWhitespace": true,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 120,

  "// File Settings": "=====================================",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.vscode": false,
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/vendor": true,
    "bin/": true,
    "dist/": true,
    "tmp/": true
  },
  "files.associations": {
    ".env.example": "env",
    ".env.local": "env",
    "Makefile": "makefile",
    ".golangci.yml": "yaml",
    ".agent.md": "markdown"
  },

  "// Go Settings": "=====================================",
  "go.useLanguageServer": true,
  "go.lintOnSave": "package",
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--timeout=5m"
  ],
  "go.formatOnSave": true,
  "go.format.goimportsLocalPrefix": "github.com/fuju/backend",
  "go.coverOnSingleTest": true,
  "go.coverMode": "atomic",
  "go.testTimeout": "10s",
  "go.testOnSave": false,
  "go.testEnvVars": {},
  "go.gopath": "",
  "go.alternateTools": {
    "go-langserver": "gopls"
  },
  "go.lintOnSaveMode": "package",
  "gopls": {
    "ui.diagnostic.annotations": {
      "bounds": true,
      "nil": true,
      "escape": true,
      "inline": true,
      "shadow": true
    },
    "formatting.goimports": true,
    "ui.semanticTokens": true
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.snippetSuggestions": "none"
  },

  "// JSON Settings": "=====================================",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  "// YAML Settings": "=====================================",
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "// Markdown Settings": "=====================================",
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "// Search Settings": "=====================================",
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.git": true,
    "bin/": true,
    "dist/": true,
    "*.out": true,
    "coverage.out": true
  },

  "// Terminal Settings": "=====================================",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.scrollback": 5000,

  "// Debug Settings": "=====================================",
  "debug.openExplorerOnEnd": false,
  "debug.inlineValues": "on",

  "// Git Settings": "=====================================",
  "git.autofetch": true,
  "git.fetchOnPull": true,
  "git.branchProtection": [
    "main",
    "master"
  ],

  "// Test Explorer Settings": "=====================================",
  "testExplorer.showCodeLens": true,

  "// Security Bank Settings": "=====================================",
  "security.workspace.trust.untrustedFiles": "open",

  "// Prettier Settings": "=====================================",
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  "prettier.semi": true,
  "prettier.singleQuote": false,
  "prettier.trailingComma": "es5",
  "prettier.bracketSpacing": true,
  "prettier.arrowParens": "always",

  "// Extension Specific Settings": "=====================================",
  "errorLens.enabled": true,
  "errorLens.followCursorMore": true,
  "errorLens.excludeBySource": [],
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "IDEA",
    "NOTE",
    "INFO"
  ],
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|\\*|^\\s*)\\s*($TAGS)\\s*:?\\s*(.*)$"
}
